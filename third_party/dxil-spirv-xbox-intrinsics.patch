+// Xbox (GDKX) DXC intrinsics ("xbox.*" functions in DXIL targeting dxil-ms-xb2).
+static bool emit_xbox_intrinsic(Converter::Impl &impl, const llvm::CallInst *call)
+{
+	auto &builder = impl.builder();
+	std::string name = call->getCalledFunction()->getName().data();
+
+	if (name == "xbox.MemTime")
+	{
+		// __XB_MemTime(): 64-bit GPU clock as { lo, hi }. Lowered to OpReadClockKHR, which returns
+		// the same pair as a uvec2 (OpCompositeExtract on it matches extractvalue on the struct).
+		// Subgroup scope: the only scope every VK_KHR_shader_clock device offers.
+		//
+		// The host environment (set by vkd3d-proton / the user) selects:
+		//   XSL_SHADER_CLOCK_SCOPE=device  device-scope clock (comparable across dispatches), else
+		//                                  subgroup scope, the only one every implementation has;
+		//   XSL_MEMTIME_SCALE=num/den      host ticks -> console GPU clocks (titles assume the
+		//                                  console's core clock, e.g. 1565 MHz on Lockhart).
+		builder.addExtension("SPV_KHR_shader_clock");
+		builder.addCapability(spv::CapabilityShaderClockKHR);
+		char scope_env[16] = "", scale_env[64] = "";
+		xsl_env("XSL_SHADER_CLOCK_SCOPE", scope_env, sizeof(scope_env));
+		xsl_env("XSL_MEMTIME_SCALE", scale_env, sizeof(scale_env));
+		spv::Scope scope = strcmp(scope_env, "device") == 0 ? spv::ScopeDevice : spv::ScopeSubgroup;
+		unsigned long long num = 0, den = 1;
+		if (scale_env[0] && sscanf(scale_env, "%llu/%llu", &num, &den) < 1)
+			num = 0;
+		if (!den)
+			den = 1;
+
+		spv::Id uint_type = builder.makeUintType(32);
+		spv::Id uvec2 = builder.makeVectorType(uint_type, 2);
+		Operation *clk = impl.allocate(spv::OpReadClockKHR, uvec2);
+		clk->add_id(builder.makeUintConstant(scope));
+		impl.add(clk);
+		spv::Id value = clk->id;
+
+		if (num && num != den)
+		{
+			// value = uvec2(uint64(clock) * num / den)
+			builder.addCapability(spv::CapabilityInt64);
+			spv::Id u64 = builder.makeUintType(64);
+			Operation *wide = impl.allocate(spv::OpBitcast, u64);
+			wide->add_id(value);
+			impl.add(wide);
+			Operation *mul = impl.allocate(spv::OpIMul, u64);
+			mul->add_id(wide->id);
+			mul->add_id(builder.makeUint64Constant(num));
+			impl.add(mul);
+			Operation *div = impl.allocate(spv::OpUDiv, u64);
+			div->add_id(mul->id);
+			div->add_id(builder.makeUint64Constant(den));
+			impl.add(div);
+			Operation *narrow = impl.allocate(spv::OpBitcast, uvec2);
+			narrow->add_id(div->id);
+			impl.add(narrow);
+			value = narrow->id;
+		}
+
+		auto meta = impl.llvm_composite_meta.find(call);
+		bool scalar = meta != impl.llvm_composite_meta.end() && meta->second.components == 1 && !meta->second.forced_composite;
+		// When only .x is read, extractvalue forwards the call's id: give the call the scalar.
+		Operation *result = impl.allocate(scalar ? spv::OpCompositeExtract : spv::OpCopyObject, call, scalar ? uint_type : uvec2);
+		result->add_id(value);
+		if (scalar)
+			result->add_literal(0);
+		impl.add(result);
+		return true;
+	}
+
+	LOGE("Unsupported Xbox intrinsic %s.\n", name.c_str());
+	return false;
+}
