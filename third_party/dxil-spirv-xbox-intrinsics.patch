+#ifdef _WIN32
+extern "C" __declspec(dllimport) unsigned long __stdcall GetEnvironmentVariableA(const char *, char *, unsigned long);
+#endif
+// Process environment as the host API sees it (the CRT copy misses variables set after start-up).
+static void xsl_env(const char *name, char *out, unsigned long size)
+{
+	out[0] = '\0';
+#ifdef _WIN32
+	unsigned long n = GetEnvironmentVariableA(name, out, size);
+	if (n == 0 || n >= size)
+		out[0] = '\0';
+#else
+	if (const char *v = getenv(name))
+	{
+		strncpy(out, v, size - 1);
+		out[size - 1] = '\0';
+	}
+#endif
+}
